{
  "name": "whatsapp-ai-system",
  "version": "6.0.0",
  "description": "أوتو جوردن - نظام خدمة عملاء ذكي لمتجر سيارات عبر واتساب",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "dev:client": "cd client && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:client\"",
    "build": "cd client && npm run build",
    "build:netlify": "cd client && npm install && npm run build",
    "install:all": "npm install && cd client && npm install",
    "netlify:dev": "netlify dev",
    "test": "node scripts/run-tests.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "groq-sdk": "^0.9.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-schedule": "^2.1.1",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
