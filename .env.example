# ============================================================
# WhatsApp AI Dashboard v6 - Environment Variables
# انسخ هذا الملف وأعد تسميته .env ثم أضف قيمك الحقيقية
# ⚠️ جميع المتغيرات المشار إليها بـ [REQUIRED] إلزامية
# ============================================================

# ─── WhatsApp Business Cloud API ───────────────────────────
# من Meta Developer Console → API Setup → Temporary/Permanent Token
WHATSAPP_TOKEN=your_permanent_access_token           # [REQUIRED]
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id        # [REQUIRED]
# ⚠️ [REQUIRED] اختر قيمة عشوائية سرية — لا تستخدم القيمة المكتوبة هنا
# ولّد قيمة: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WHATSAPP_VERIFY_TOKEN=generate_your_own_random_token_here

# ─── Groq AI ───────────────────────────────────────────────
# من https://console.groq.com → API Keys
GROQ_API_KEY=your_groq_api_key                       # [REQUIRED]
GROQ_MODEL=qwen/qwen3-32b                            # [optional] default primary model
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile          # [optional] fallback when primary hits TPD

# ─── Supabase (إلزامي للإنتاج — in-memory fallback للتطوير فقط) ──
# من https://supabase.com → Project Settings → API
# SUPABASE_SERVICE_KEY = المفتاح service_role (ليس anon)
SUPABASE_URL=https://your-project-id.supabase.co     # [REQUIRED in production]
SUPABASE_SERVICE_KEY=your_service_role_key_here      # [REQUIRED in production]

# ─── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# [REQUIRED] لا تستخدم القيمة الافتراضية — ولّد واحدة قوية:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate_a_min_32_character_random_secret_here

# ─── CORS ──────────────────────────────────────────────────
# [REQUIRED in production] قائمة المواقع المسموح لها (مفصولة بفواصل)
CORS_ORIGIN=https://yourdomain.com,https://admin.yourdomain.com

# ─── Admin Credentials ─────────────────────────────────────
# [REQUIRED] لا يوجد قيم افتراضية — اختر قيماً قوية
# كلمة المرور يجب ألا تقل عن 12 حرفاً
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=use_a_strong_password_min_12_chars
